<!--Dashboard.ejs finished-->
<!DOCTYPE html>
<html>
<head>

    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand" href="/">Real Lab</a>

        <div>

            <a class="nav-link d-inline text-white me-3" href="/">Home</a>
            <a class="nav-link d-inline text-white me-3" href="/calculator">Calculator</a>
            <a class="nav-link d-inline text-white" href="/dashboard">Dashboard</a>

        </div>

    </div>

</nav>

<div class="container mt-5">

    <h1>Fitness Profiles</h1>

    <table class="table table-bordered">

        <thead>

        <tr>
            <th>Name</th>
            <th>Goal</th>
            <th>Calories</th>
        </tr>

        </thead>

        <tbody>

        <% profiles.forEach(function(profile) { %>

            <tr>

                <td><%= profile.name %></td>
                <td><%= profile.goal %></td>
                <td><%= profile.calories %></td>

            </tr>

        <% }) %>

        </tbody>

    </table>

</div>

</body>
</html>
