<!DOCTYPE html>
<html>
<head>
    <title>Calculator</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand" href="/">Real Lab</a>

        <div>
            <a class="nav-link d-inline text-white me-3" href="/">Home</a>
            <a class="nav-link d-inline text-white me-3" href="/calculator">Calculator</a>
            <a class="nav-link d-inline text-white" href="/dashboard">Dashboard</a>
        </div>

    </div>

</nav>

<div class="container mt-5">

    <h1>Calorie Calculator</h1>

    <form method="POST" action="/calculator">

        <div class="mb-3">
            <label>Name</label>
            <input type="text"
                   name="name"
                   class="form-control"
                   required>
        </div>

        <div class="mb-3">
            <label>Weight (kg)</label>
            <input type="number"
                   name="weight"
                   class="form-control"
                   required>
        </div>

        <div class="mb-3">
            <label>Goal</label>

            <select name="goal"
                    class="form-control">

                <option>Weight Loss</option>
                <option>Maintain Weight</option>
                <option>Weight Gain</option>

            </select>

        </div>

        <button type="submit"
                class="btn btn-success">

            Calculate Calories

        </button>

    </form>

    <% if (result) { %>

        <div class="alert alert-success mt-4">

            Estimated Daily Calories:
            <strong><%= result %></strong>

        </div>

    <% } %>

</div>

</body>
</html>